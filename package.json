{
  "name": "becommunity-software",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:calc && npm run test:business-calc && npm run test:ingestion-core && npm run test:atomic-ingestion && npm run test:import-center && npm run test:templates && npm run test:bi-filters && npm run test:qualitative && npm run test:confirmed-qualitative && npm run test:client-boundary && npm run test:publication-boundary && npm run test:data-scope && npm run test:client-admin && npm run test:study-config && npm run test:longitudinal && npm run test:narrative-home && npm run test:server-pdf && npm run test:tenant-branding && npm run test:validation",
    "test:calc": "tsx scripts/calculation-test.mjs",
    "test:business-calc": "tsx scripts/business-calculation-test.mjs",
    "test:ingestion-core": "tsx scripts/universal-ingestion-test.mjs",
    "test:atomic-ingestion": "tsx scripts/atomic-ingestion-test.mjs",
    "test:atomic-live": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/atomic-ingestion-live-test.mjs",
    "test:import-center": "tsx scripts/import-center-test.mjs",
    "test:templates": "tsx scripts/template-system-test.mjs",
    "test:templates-live": "node --env-file=.env.local scripts/template-live-test.mjs",
    "test:bi-filters": "tsx scripts/bi-filter-test.mjs",
    "test:qualitative": "tsx scripts/qualitative-triage-test.mjs",
    "test:qualitative-live": "node --env-file=.env.local scripts/qualitative-triage-live-test.mjs",
    "test:confirmed-qualitative": "tsx scripts/confirmed-qualitative-test.mjs",
    "test:client-boundary": "tsx scripts/client-data-boundary-test.mjs",
    "test:publication-boundary": "tsx scripts/publication-boundary-test.mjs",
    "test:data-scope": "tsx scripts/data-scope-test.mjs",
    "test:client-admin": "tsx scripts/client-admin-test.mjs",
    "test:client-admin-live": "node --env-file=.env.local scripts/client-admin-live-test.mjs",
    "test:study-config": "tsx scripts/study-config-test.mjs",
    "test:longitudinal": "tsx scripts/longitudinal-test.mjs",
    "test:narrative-home": "tsx scripts/narrative-home-test.mjs",
    "test:server-pdf": "tsx scripts/server-pdf-test.mjs",
    "test:tenant-branding": "tsx scripts/tenant-branding-test.mjs",
    "test:tenant-branding-live": "node --env-file=.env.local scripts/tenant-branding-live-test.mjs",
    "test:import-center-live": "node --env-file=.env.local scripts/import-center-live-test.mjs",
    "test:validation": "tsx scripts/validation-test.mjs",
    "test:isolation": "node --env-file=.env.local scripts/isolation-test.mjs",
    "test:secrets": "node --env-file=.env.local scripts/secret-leak-test.mjs",
    "gates": "npm run typecheck && npm run build && npm run test && npm run test:qualitative-live && npm run test:isolation && npm run test:secrets",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "arquero": "8.0.3",
    "exceljs": "4.4.0",
    "next": "16.2.9",
    "papaparse": "5.5.4",
    "pdf-lib": "1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "4.22.4",
    "typescript": "^5",
    "wrangler": "4.106.0"
  }
}
